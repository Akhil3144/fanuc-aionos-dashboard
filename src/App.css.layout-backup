:root {
  --bg: #0b1117;
  --bg-soft: #0e151c;

  --panel: rgba(18, 27, 36, 0.88);
  --panel-strong: #121b24;
  --panel-soft: #151f29;

  --line: rgba(142, 169, 191, 0.13);
  --line-strong: rgba(142, 169, 191, 0.22);

  --text: #f3f6f8;
  --text-soft: #c5d0d8;
  --muted: #7f909e;
  --muted-soft: #61717e;

  --success: #55d99a;
  --warning: #e3b75b;
  --danger: #f06c6c;
  --blue: #73a8d8;
  --cyan: #73c7cb;

  --radius-xl: 24px;
  --radius-lg: 18px;
  --radius-md: 13px;
  --radius-sm: 9px;

  font-family:
    "SF Pro Display",
    "SF Pro Text",
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: var(--text);
  background: var(--bg);
}

/* =========================================================
   GLOBAL
========================================================= */

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;

  color: var(--text);

  background:
    radial-gradient(
      circle at 12% -10%,
      rgba(80, 130, 170, 0.2),
      transparent 33%
    ),
    radial-gradient(
      circle at 92% 5%,
      rgba(47, 110, 126, 0.12),
      transparent 28%
    ),
    linear-gradient(
      180deg,
      #0d151c 0%,
      #0a1016 56%,
      #091016 100%
    );

  -webkit-font-smoothing: antialiased;
}

button,
input,
textarea,
select {
  font: inherit;
}

/* =========================================================
   APP
========================================================= */

.app-shell {
  width: min(1680px, 100%);

  margin: 0 auto;

  padding:
    28px
    clamp(22px, 3vw, 50px)
    36px;
}

/* =========================================================
   HEADER
========================================================= */

.site-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  gap: 32px;

  padding: 10px 2px 24px;
}

.brand-kicker {
  color: #92a9bb;

  font-size: 14px;
  font-weight: 650;

  letter-spacing: 2.2px;
  text-transform: uppercase;

  margin-bottom: 8px;
}

.brand-block h1 {
  margin: 0;

  color: #f8fafc;

  font-size: clamp(30px, 3vw, 46px);
  font-weight: 650;

  letter-spacing: -1.6px;
}

.brand-block p {
  margin: 8px 0 0;

  color: #8394a2;

  font-size: 15px;
}

.header-context {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;

  gap: 8px;
}

.context-item {
  padding: 8px 12px;

  border-right: 1px solid var(--line);
}

.context-item span {
  display: block;

  color: var(--muted-soft);

  font-size: 11px;

  letter-spacing: 1px;
  text-transform: uppercase;

  margin-bottom: 4px;
}

.context-item strong {
  font-size: 13px;
  font-weight: 600;

  color: #d6dfe5;
}

.connection-chip,
.mode-chip,
.readonly-chip {
  display: flex;
  align-items: center;

  min-height: 36px;

  padding: 0 12px;

  border: 1px solid var(--line-strong);
  border-radius: 10px;

  background: rgba(18, 28, 37, 0.72);

  backdrop-filter: blur(14px);

  color: #c7d1d9;

  font-size: 12px;
  font-weight: 650;

  letter-spacing: 0.3px;
}

.connection-chip {
  gap: 7px;
}

.readonly-chip {
  color: #e4c370;
}

/* =========================================================
   STATUS DOTS
========================================================= */

.status-dot {
  width: 7px;
  height: 7px;

  flex: 0 0 7px;

  display: inline-block;

  border-radius: 50%;
}

.status-success {
  background: var(--success);

  box-shadow:
    0 0 0 4px rgba(85, 217, 154, 0.07),
    0 0 12px rgba(85, 217, 154, 0.35);
}

.status-warning {
  background: var(--warning);

  box-shadow:
    0 0 0 4px rgba(227, 183, 91, 0.07),
    0 0 12px rgba(227, 183, 91, 0.28);
}

.status-danger {
  background: var(--danger);

  box-shadow:
    0 0 0 4px rgba(240, 108, 108, 0.07),
    0 0 12px rgba(240, 108, 108, 0.3);
}

.status-neutral {
  background: #8ba6bc;
}

.status-muted {
  background: #465762;
}

/* =========================================================
   CONTEXT BAR
========================================================= */

.context-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  overflow: hidden;

  margin-bottom: 14px;

  border: 1px solid var(--line);
  border-radius: 14px;

  background: rgba(15, 23, 31, 0.76);

  backdrop-filter: blur(16px);
}

.context-bar > div {
  padding: 11px 15px;

  border-right: 1px solid var(--line);
}

.context-bar > div:last-child {
  border-right: none;
}

.context-bar span {
  display: block;

  color: var(--muted-soft);

  font-size: 11px;

  letter-spacing: 0.9px;
  text-transform: uppercase;

  margin-bottom: 4px;
}

.context-bar strong {
  color: #d7e0e6;

  font-size: 13px;
  font-weight: 600;
}

/* =========================================================
   EXECUTIVE KPI STRIP
========================================================= */

.kpi-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);

  gap: 10px;

  margin-bottom: 34px;
}

.executive-kpi {
  position: relative;

  overflow: hidden;

  min-height: 105px;

  padding: 16px;

  border: 1px solid var(--line);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(23, 34, 44, 0.92),
      rgba(15, 24, 32, 0.88)
    );

  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.16);
}

.executive-kpi::after {
  content: "";

  position: absolute;

  right: -25px;
  bottom: -40px;

  width: 90px;
  height: 90px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(103, 156, 193, 0.09),
      transparent 65%
    );
}

.kpi-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 11px;
}

.kpi-topline > span:first-child {
  color: #8193a2;

  font-size: 12px;

  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.executive-kpi > strong {
  display: block;

  color: #f6f8fa;

  font-size: 22px;
  font-weight: 650;

  letter-spacing: -0.5px;

  margin-bottom: 3px;
}

.executive-kpi small {
  color: #657785;

  font-size: 12px;
}

/* =========================================================
   SECTIONS
========================================================= */

.dashboard-content {
  display: flex;
  flex-direction: column;

  gap: 36px;
}

.dashboard-section {
  min-width: 0;
}

.section-heading {
  margin-bottom: 13px;
}

.section-heading > div {
  display: flex;
  align-items: center;

  gap: 12px;
}

.section-heading > div > span {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--line-strong);
  border-radius: 50%;

  color: #718594;

  font-size: 12px;
  font-weight: 650;
}

.section-heading h2 {
  margin: 0;

  font-size: 16px;
  font-weight: 620;

  letter-spacing: -0.2px;
}

.section-heading p {
  margin: 3px 0 0;

  color: #71828f;

  font-size: 12px;
}

.section-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));

  gap: 12px;

  align-items: start;
}

.production-panel {
  grid-column: span 7;
}

.live-panel {
  grid-column: span 5;
}

.health-panel {
  grid-column: span 3;
}

.alarm-panel {
  grid-column: span 4;
}

.maintenance-panel {
  grid-column: span 5;
}

.insight-panel {
  grid-column: span 5;
}

.axis-panel {
  grid-column: span 4;
}

.energy-panel {
  grid-column: span 3;
}

/* =========================================================
   PANELS
========================================================= */

.panel {
  position: relative;

  min-width: 0;

  overflow: hidden;

  padding: 17px;

  border: 1px solid var(--line);
  border-radius: var(--radius-lg);

  background:
    linear-gradient(
      145deg,
      rgba(18, 28, 37, 0.94),
      rgba(14, 22, 30, 0.92)
    );

  box-shadow:
    0 15px 45px rgba(0, 0, 0, 0.13);
}

.panel-feature {
  background:
    linear-gradient(
      145deg,
      rgba(22, 34, 44, 0.97),
      rgba(14, 23, 31, 0.94)
    );
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;

  margin-bottom: 15px;
}

.panel-eyebrow {
  display: block;

  color: #647988;

  font-size: 11px;

  letter-spacing: 1.2px;
  text-transform: uppercase;

  margin-bottom: 5px;
}

.panel-header h2 {
  margin: 0;

  color: #f0f4f6;

  font-size: 15px;
  font-weight: 620;

  letter-spacing: -0.25px;
}

.panel-header p {
  margin: 4px 0 0;

  max-width: 360px;

  color: #738592;

  font-size: 12px;
  line-height: 1.45;
}

.source-tag {
  flex: 0 0 auto;

  padding: 5px 7px;

  border: 1px solid rgba(125, 156, 180, 0.14);
  border-radius: 7px;

  background: rgba(106, 143, 170, 0.06);

  color: #7890a2;

  font-size: 13px;
  font-weight: 600;

  letter-spacing: 0.2px;
}

/* =========================================================
   GENERIC METRICS
========================================================= */

.metric-caption {
  display: block;

  color: #6a7d8a;

  font-size: 11px;

  letter-spacing: 0.9px;
  text-transform: uppercase;

  margin-bottom: 5px;
}

.hero-number {
  display: block;

  color: #f7f9fa;

  font-size: 36px;
  font-weight: 650;

  letter-spacing: -1.8px;

  line-height: 1;
}

.text-success {
  color: var(--success) !important;
}

.text-warning {
  color: var(--warning) !important;
}

.text-danger {
  color: var(--danger) !important;
}

.text-neutral {
  color: var(--text-soft) !important;
}

/* =========================================================
   PRODUCTION
========================================================= */

.production-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  gap: 24px;

  padding: 2px 2px 18px;
}

.production-hero small,
.oee-focus small {
  display: block;

  margin-top: 5px;

  color: #637481;

  font-size: 11px;
}

.oee-focus {
  text-align: right;
}

.oee-focus strong {
  display: block;

  color: #f6f9fb;

  font-size: 30px;
  font-weight: 620;

  letter-spacing: -1px;
}

.time-distribution {
  display: flex;

  width: 100%;
  height: 9px;

  overflow: hidden;

  border-radius: 999px;

  background: #19242d;

  margin-bottom: 10px;
}

.time-segment {
  height: 100%;
}

.time-running {
  background: var(--success);
}

.time-idle {
  background: var(--warning);
}

.time-ready {
  background: #6996ba;
}

.time-fault {
  background: var(--danger);
}

.production-time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  gap: 7px;
}

.production-time-grid > div {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;

  column-gap: 6px;

  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(11, 19, 26, 0.54);
}

.production-time-grid span:not(.legend-dot) {
  color: #738694;

  font-size: 11px;
}

.production-time-grid strong {
  grid-column: 2;

  font-size: 12px;
}

.legend-dot {
  width: 5px;
  height: 5px;

  grid-row: span 2;

  border-radius: 50%;
}

.legend-running {
  background: var(--success);
}

.legend-idle {
  background: var(--warning);
}

.legend-ready {
  background: #6996ba;
}

.legend-fault {
  background: var(--danger);
}

.production-bottom {
  display: grid;
  grid-template-columns: 1.1fr 1fr;

  gap: 9px;

  margin-top: 11px;
}

.cycle-summary,
.oee-components {
  padding: 10px;

  border: 1px solid var(--line);
  border-radius: 11px;

  background: rgba(9, 16, 22, 0.46);
}

.cycle-summary > div,
.oee-components > div {
  display: flex;
  justify-content: space-between;

  gap: 12px;

  padding: 4px 0;
}

.cycle-summary span,
.oee-components span {
  color: #738592;

  font-size: 11px;
}

.cycle-summary strong,
.oee-components strong {
  color: #dce4e9;

  font-size: 12px;
}

/* =========================================================
   LIVE CELL
========================================================= */

.live-state-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 14px;

  padding: 2px 2px 13px;

  border-bottom: 1px solid var(--line);
}

.state-heading {
  display: flex;
  align-items: center;

  gap: 9px;

  font-size: 25px;
  font-weight: 650;

  letter-spacing: -0.8px;
}

.state-ready,
.state-running {
  color: var(--success);
}

.state-idle {
  color: var(--warning);
}

.state-faulted {
  color: var(--danger);
}

.program-block {
  text-align: right;
}

.program-block span,
.live-meta span,
.register-row span {
  display: block;

  color: #647783;

  font-size: 11px;

  letter-spacing: 0.7px;
  text-transform: uppercase;

  margin-bottom: 4px;
}

.program-block strong {
  font-size: 13px;
}

.live-meta {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 7px;

  margin: 11px 0;
}

.live-meta > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(10, 17, 23, 0.43);
}

.live-meta strong {
  font-size: 12px;
}

.signal-groups {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 14px;

  margin-top: 13px;
}

.subsection-title {
  display: block;

  color: #647987;

  font-size: 11px;

  letter-spacing: 0.9px;
  text-transform: uppercase;

  margin-bottom: 6px;
}

.signal-line {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 10px;

  padding: 5px 0;

  border-bottom: 1px solid rgba(130, 155, 173, 0.08);

  color: #8d9da8;

  font-size: 11px;
}

.signal-line strong {
  display: flex;
  align-items: center;

  gap: 5px;

  font-size: 11px;
}

.signal-active {
  color: var(--success);
}

.signal-inactive {
  color: #60707c;
}

.register-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 7px;

  margin-top: 11px;
}

.register-row > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(10, 17, 23, 0.43);
}

.register-row strong {
  font-size: 12px;
}

/* =========================================================
   HEALTH
========================================================= */

.health-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 10px;

  padding: 11px;

  border: 1px solid rgba(85, 217, 154, 0.18);
  border-radius: 11px;

  background: rgba(85, 217, 154, 0.04);
}

.health-banner.health-attention {
  border-color: rgba(227, 183, 91, 0.2);

  background: rgba(227, 183, 91, 0.04);
}

.health-banner span,
.health-foot span {
  display: block;

  color: #657884;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 4px;
}

.health-banner strong {
  display: flex;
  align-items: center;

  gap: 7px;

  font-size: 16px;
}

.health-banner small {
  color: #596a76;

  font-size: 11px;
}

.health-status-list {
  margin-top: 11px;
}

.health-status-list > div {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 8px 0;

  border-bottom: 1px solid var(--line);

  color: #8797a2;

  font-size: 11px;
}

.health-status-list strong {
  display: flex;
  align-items: center;

  gap: 6px;

  font-size: 11px;
}

.health-foot {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 6px;

  margin-top: 10px;
}

.health-foot > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 9px;

  background: rgba(10, 17, 23, 0.42);
}

.health-foot strong {
  font-size: 12px;
}

/* =========================================================
   ALARMS
========================================================= */

.alarm-overview,
.maintenance-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 6px;

  margin-bottom: 10px;
}

.alarm-overview > div,
.maintenance-overview > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 9px;

  background: rgba(10, 17, 23, 0.43);
}

.alarm-overview span,
.maintenance-overview span {
  display: block;

  color: #657884;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 3px;
}

.alarm-overview strong,
.maintenance-overview strong {
  font-size: 16px;
}

.compact-list {
  display: flex;
  flex-direction: column;

  gap: 6px;
}

.compact-event {
  display: grid;
  grid-template-columns: auto 1fr auto;

  gap: 8px;

  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(9, 17, 23, 0.42);
}

.event-active {
  border-color: rgba(240, 108, 108, 0.28);

  background:
    linear-gradient(
      90deg,
      rgba(240, 108, 108, 0.045),
      rgba(9, 17, 23, 0.42)
    );
}

.event-marker {
  padding-top: 2px;
}

.event-title-line {
  display: flex;
  align-items: center;

  gap: 6px;
}

.event-title-line strong {
  font-size: 12px;
}

.event-title-line span {
  color: #60727e;

  font-size: 11px;

  text-transform: uppercase;
}

.event-content p {
  margin: 3px 0;

  color: #9cabb4;

  font-size: 11px;
  line-height: 1.35;
}

.event-content small {
  color: #566875;

  font-size: 11px;
}

.event-severity {
  height: fit-content;

  padding: 3px 5px;

  border-radius: 5px;

  font-size: 11px;
  font-weight: 700;
}

.severity-high {
  color: var(--danger);
  background: rgba(240, 108, 108, 0.08);
}

.severity-medium {
  color: var(--warning);
  background: rgba(227, 183, 91, 0.08);
}

.severity-low {
  color: var(--success);
  background: rgba(85, 217, 154, 0.08);
}

/* =========================================================
   MAINTENANCE
========================================================= */

.maintenance-list-modern {
  display: flex;
  flex-direction: column;

  gap: 6px;
}

.maintenance-row-modern {
  position: relative;

  overflow: hidden;

  padding: 9px 9px 9px 12px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(9, 17, 23, 0.43);
}

.maintenance-priority-line {
  position: absolute;

  top: 0;
  bottom: 0;
  left: 0;

  width: 3px;
}

.priority-danger {
  background: var(--danger);
}

.priority-warning {
  background: var(--warning);
}

.priority-success {
  background: var(--success);
}

.maintenance-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;
}

.maintenance-main strong {
  display: block;

  color: #dfe6ea;

  font-size: 12px;
}

.maintenance-main small {
  display: block;

  margin-top: 2px;

  color: #586a76;

  font-size: 11px;
}

.maintenance-state {
  font-size: 11px;
  font-weight: 700;
}

.maintenance-data {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 5px;

  margin-top: 8px;
}

.maintenance-data span {
  display: block;

  color: #5f717e;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 2px;
}

.maintenance-data strong {
  font-size: 11px;
}

.life-progress {
  height: 3px;

  overflow: hidden;

  margin-top: 7px;

  border-radius: 999px;

  background: #1a2630;
}

.life-progress-fill {
  height: 100%;

  border-radius: 999px;
}

.progress-danger {
  background: var(--danger);
}

.progress-warning {
  background: var(--warning);
}

.progress-success {
  background: var(--success);
}

/* =========================================================
   AI INSIGHTS
========================================================= */

.insight-feature-header {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 7px;

  margin-bottom: 9px;
}

.insight-feature-header > div {
  padding: 9px;

  border: 1px solid var(--line);
  border-radius: 10px;

  background: rgba(9, 17, 23, 0.44);
}

.insight-feature-header span {
  display: block;

  color: #637683;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 3px;
}

.insight-feature-header strong {
  font-size: 15px;
}

.insight-modern-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 7px;
}

.insight-modern {
  padding: 10px;

  border: 1px solid var(--line);
  border-radius: 11px;

  background: rgba(10, 18, 25, 0.48);
}

.insight-tone-danger {
  border-color: rgba(240, 108, 108, 0.18);
}

.insight-tone-warning {
  border-color: rgba(227, 183, 91, 0.18);
}

.insight-modern-top {
  display: flex;
  justify-content: space-between;

  gap: 8px;

  margin-bottom: 5px;
}

.insight-modern-top span {
  color: #657987;

  font-size: 11px;
  font-weight: 650;

  letter-spacing: 0.6px;
  text-transform: uppercase;
}

.insight-modern > strong {
  display: block;

  color: #e3e9ed;

  font-size: 12px;
  line-height: 1.35;
}

.insight-modern > p {
  margin: 5px 0 0;

  color: #84949f;

  font-size: 11px;
  line-height: 1.45;
}

.recommendation-line {
  margin-top: 7px;

  padding-top: 6px;

  border-top: 1px solid var(--line);
}

.recommendation-line span {
  display: block;

  color: #648baa;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 3px;
}

.recommendation-line p {
  margin: 0;

  color: #a5b3bc;

  font-size: 11px;
  line-height: 1.4;
}

/* =========================================================
   AXIS
========================================================= */

.axis-highlight {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 6px;

  margin-bottom: 9px;
}

.axis-highlight > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 9px;

  background: rgba(10, 17, 23, 0.43);
}

.axis-highlight span {
  display: block;

  color: #627582;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 3px;
}

.axis-highlight strong {
  font-size: 12px;
}

.axis-modern-table {
  min-width: 0;
}

.axis-table-head,
.axis-table-row {
  display: grid;

  grid-template-columns:
    32px
    minmax(60px, 1.2fr)
    42px
    minmax(60px, 0.9fr)
    70px;

  gap: 6px;

  align-items: center;
}

.axis-table-head {
  padding: 0 4px 5px;

  color: #596c79;

  font-size: 11px;

  text-transform: uppercase;
}

.axis-table-row {
  padding: 7px 4px;

  border-top: 1px solid var(--line);

  color: #8798a3;

  font-size: 11px;
}

.axis-table-row > strong {
  color: #dce4e8;

  font-size: 11px;
}

.axis-load-modern > span {
  display: block;

  margin-bottom: 3px;

  font-size: 11px;
}

.axis-load-modern > div {
  height: 3px;

  overflow: hidden;

  border-radius: 999px;

  background: #1b2730;
}

.axis-load-modern i {
  display: block;

  height: 100%;

  border-radius: 999px;

  background: var(--success);
}

.axis-state {
  display: flex;
  align-items: center;

  gap: 5px;

  font-size: 11px;
  font-weight: 650;
}

/* =========================================================
   ENERGY
========================================================= */

.energy-hero-modern {
  display: grid;
  grid-template-columns: 1.3fr 1fr;

  gap: 7px;

  margin-bottom: 11px;
}

.energy-hero-modern > div {
  padding: 11px;

  border: 1px solid var(--line);
  border-radius: 11px;

  background: rgba(10, 17, 23, 0.43);
}

.energy-hero-modern span {
  display: block;

  color: #617480;

  font-size: 11px;

  text-transform: uppercase;

  margin-bottom: 4px;
}

.energy-hero-modern strong {
  color: #edf2f4;

  font-size: 18px;

  letter-spacing: -0.4px;
}

.energy-hero-modern small {
  margin-left: 3px;

  color: #677985;

  font-size: 11px;
}

.energy-modern-bars {
  display: flex;
  flex-direction: column;

  gap: 9px;
}

.energy-modern-bars > div > div:first-child {
  display: flex;
  justify-content: space-between;

  gap: 8px;

  margin-bottom: 4px;
}

.energy-modern-bars span {
  color: #697b88;

  font-size: 11px;
}

.energy-modern-bars strong {
  font-size: 11px;
}

.energy-modern-track {
  height: 4px;

  overflow: hidden;

  border-radius: 999px;

  background: #1b2730;
}

.energy-modern-track i {
  display: block;

  height: 100%;

  border-radius: 999px;
}

.energy-running {
  background: var(--success);
}

.energy-idle {
  background: var(--warning);
}

.energy-regen {
  background: #65a7db;
}

.energy-mini-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  gap: 6px;

  margin-top: 11px;
}

.energy-mini-grid > div {
  padding: 8px;

  border: 1px solid var(--line);
  border-radius: 9px;

  background: rgba(10, 17, 23, 0.42);
}

.energy-mini-grid span {
  display: block;

  color: #657785;

  font-size: 11px;

  margin-bottom: 3px;
}

.energy-mini-grid strong {
  font-size: 11px;
}

/* =========================================================
   ERROR / BOOT
========================================================= */

.error-banner {
  margin-bottom: 12px;

  padding: 10px 12px;

  border: 1px solid rgba(240, 108, 108, 0.28);
  border-radius: 10px;

  background: rgba(240, 108, 108, 0.06);

  color: #ef9a9a;

  font-size: 12px;
}

.boot-screen {
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 7px;

  background: var(--bg);

  color: #dfe7eb;
}

.boot-mark {
  width: 28px;
  height: 28px;

  margin-bottom: 4px;

  border: 2px solid rgba(115, 168, 216, 0.18);
  border-top-color: #7ba9d0;
  border-radius: 50%;

  animation: spin 0.8s linear infinite;
}

.boot-screen strong {
  font-size: 15px;
}

.boot-screen span {
  color: #687986;

  font-size: 12px;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* =========================================================
   FOOTER
========================================================= */

.dashboard-footer {
  display: flex;
  justify-content: space-between;

  gap: 20px;

  margin-top: 34px;
  padding-top: 16px;

  border-top: 1px solid var(--line);

  color: #52636f;

  font-size: 11px;

  letter-spacing: 0.4px;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1250px) {
  .production-panel,
  .live-panel {
    grid-column: span 6;
  }

  .health-panel {
    grid-column: span 4;
  }

  .alarm-panel {
    grid-column: span 4;
  }

  .maintenance-panel {
    grid-column: span 4;
  }

  .insight-panel {
    grid-column: span 6;
  }

  .axis-panel {
    grid-column: span 6;
  }

  .energy-panel {
    grid-column: span 12;
  }

  .energy-panel .energy-modern-bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 900px) {
  .site-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .header-context {
    justify-content: flex-start;
  }

  .context-bar {
    grid-template-columns: repeat(2, 1fr);
  }

  .context-bar > div:nth-child(2) {
    border-right: none;
  }

  .context-bar > div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--line);
  }

  .kpi-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .executive-kpi:last-child {
    grid-column: span 2;
  }

  .production-panel,
  .live-panel,
  .health-panel,
  .alarm-panel,
  .maintenance-panel,
  .insight-panel,
  .axis-panel,
  .energy-panel {
    grid-column: span 12;
  }

  .insight-modern-list {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .app-shell {
    padding: 18px 14px 28px;
  }

  .brand-block h1 {
    font-size: 30px;
  }

  .context-item {
    display: none;
  }

  .context-bar {
    grid-template-columns: 1fr;
  }

  .context-bar > div {
    border-right: none;
    border-bottom: 1px solid var(--line);
  }

  .context-bar > div:last-child {
    border-bottom: none;
  }

  .kpi-strip {
    grid-template-columns: 1fr;
  }

  .executive-kpi:last-child {
    grid-column: span 1;
  }

  .production-time-grid,
  .live-meta,
  .register-row {
    grid-template-columns: repeat(2, 1fr);
  }

  .production-bottom,
  .signal-groups,
  .energy-hero-modern {
    grid-template-columns: 1fr;
  }

  .axis-table-head,
  .axis-table-row {
    grid-template-columns: 28px 1fr 40px 60px;
  }

  .axis-table-head span:last-child,
  .axis-table-row .axis-state {
    display: none;
  }

  .dashboard-footer {
    flex-direction: column;
  }
}

