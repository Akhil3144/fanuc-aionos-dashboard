/* =========================================================
   10-POINT ROBOT SIMULATION REPLAY
   ========================================================= */

.simulation-replay-card {
  margin-bottom: 14px;
  min-height: auto !important;
  padding: 16px 18px !important;
}

.simulation-replay-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 13px;
}

.simulation-replay-head > div > span {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
  opacity: 0.65;
  margin-bottom: 3px;
}

.simulation-replay-head h2 {
  margin: 0;
  font-size: 17px;
  line-height: 1.2;
}

.simulation-replay-head > strong {
  font-size: 12px;
  white-space: nowrap;
}

.simulation-point-grid {
  display: grid;
  grid-template-columns: repeat(10, minmax(95px, 1fr));
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.simulation-point {
  min-width: 95px;
  padding: 9px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  opacity: 0.62;
  transition:
    opacity 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.simulation-point-active {
  opacity: 1;
  border-color: rgba(85, 220, 160, 0.75);
  transform: translateY(-2px);
}

.simulation-point-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.simulation-point-top strong {
  font-size: 12px;
}

.simulation-point-top span {
  font-size: 10px;
  opacity: 0.65;
}

.simulation-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-top: 5px;
}

.simulation-value span {
  font-size: 10px;
  opacity: 0.65;
}

.simulation-value strong {
  font-size: 11px;
  white-space: nowrap;
}

.simulation-state {
  margin-top: 8px;
  padding-top: 6px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 10px;
  font-weight: 700;
}

@media (max-width: 1100px) {
  .simulation-point-grid {
    grid-template-columns: repeat(10, 105px);
  }
}
